{
	"type": "module",
	"name": "kotlin-react-template",

	"packageManager": "bun@1.3.5",
	"workspaces": ["apps/*", "packages/*"],

	"scripts": {
		"dev": "./scripts/turbo.sh run dev",

		"fix": "./scripts/turbo.sh run fix",
		"check": "./scripts/turbo.sh run check",

		"setup": "./scripts/setup.sh",
		"codegen": "./scripts/turbo.sh run codegen"
	},

	"dependencies": {
		"effect": "latest",
		"@effect/platform": "latest",
		"@effect-atom/atom-react": "latest"
	},

	"devDependencies": {
		"@effect/language-service": "latest",
		"@typescript/native-preview": "latest",

		"typescript": "latest",
		"@types/node": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19",

		"turbo": "latest",
		"@biomejs/biome": "latest"
	}
}
